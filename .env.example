# Antidote Foundation of India (AFOI) - Environment Variables Template
# Copy this file to .env and fill in your production credentials. Never commit secrets to git.

# Production Website URL
VITE_SITE_URL=https://antidotefoundation.org

# 24/7 Helpline Contact Configuration
VITE_HELPLINE_PHONE=+917777927742
VITE_HELPLINE_DISPLAY="+91 77779 27742"

